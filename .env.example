# 环境变量示例
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 在 GitLab CI 中，这些值应通过 Settings -> CI/CD -> Variables 注入

# =========================
# 运行环境：fat 或 uat
# =========================
ENV=fat

# =========================
# FAT 环境
# =========================
BASE_URL=http://fat-pos.example.com:60030/api
DEVELOPER_ID=106825
E_POI_ID=reabamts_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SIGN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =========================
# UAT 环境
# =========================
UAT_URL=https://pos.example.com/api
DEVELOPER_ID_UAT=106824
E_POI_ID_UAT=reabam_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SIGN_UAT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =========================
# 数据库配置
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=test

# =========================
# 登录账号（用于 conftest.py access_token fixture）
# =========================
LOGIN_MOBILE=19900000000
LOGIN_WORD=e10adc3949ba59abbe56e057f20f883e

# =========================
# 企业微信机器人 webhook
# =========================
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxx

# =========================
# 通用配置
# =========================
DEFAULT_TIMEOUT=10
RETRY_TIMES=3
RETRY_INTERVAL=2
LOG_LEVEL=INFO
LOG_DIR=logs
